{
  "extends": "nolabs-ai/pi",
  "meta": {
    "name": "pi"
  },
  "groups": {
    "include": []
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "$WORKDIR",
      "/tmp"
    ],
    "read": [
      "/opt/pi-coding-agent"
    ],
    "allow_file": [
      "$SSH_AUTH_SOCK"
    ]
  }
}
